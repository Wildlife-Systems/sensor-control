#!/usr/bin/env bash

# WildlifeSystems - onboard sensors
#
# Script to read onboard sensors from a Raspberry Pi (onboard CPU and GPU) as
# well as a number of pseudo-sensors (storage used, memory used) that are useful
# for monitoring the health of the device.
#
# Reading JSON is produced by ws-emit, so this driver emits exactly what the C
# drivers emit: the same sc-prototype template, the same unit spellings, and
# "{{node}}" resolved to the node's own position rather than passed through
# unresolved. Everything below is only about reading the values.
#
# This script is part of the WildlifeSystems project. For further information
# please refer to https://docs.wildlife.systems, or for more information on
# the project itself, please refer to https://wildlife.systems.

set -u
set -o pipefail

readonly EXIT_INVALID_ARG=20
readonly EXIT_IDENTIFY=60
readonly DEVICE=raspberry_pi
# The SoC temperature, which the kernel reports in millidegrees
readonly CPU_TEMP_FILE=/sys/class/thermal/thermal_zone0/temp

# What this driver measures: the one source for the list command, the
# arguments it accepts, and its usage line, so the three cannot drift apart.
# The C drivers get the same guarantee from ws_cmd_usage.
readonly SENSORS=(onboard_gpu onboard_cpu storage_used memory_used)

usage() {
  local names
  names=$(IFS='|'; printf '%s' "${SENSORS[*]}")
  printf 'Usage: sensor-onboard [--version|-v|version|identify|list|setup|enable|mock|internal|external|all|%s]\n' \
    "${names}" >&2
}

is_sensor() {
  local s
  for s in "${SENSORS[@]}"; do
    [[ "$1" == "${s}" ]] && return 0
  done
  return 1
}

# Every reading is emitted by one ws-emit call, which owns the array and its
# commas. Common options first, then one "--" group per reading.
emit() {
  exec ws-emit --device "${DEVICE}" --internal "$@"
}

# Default to "all", as the C drivers do, rather than failing on no argument.
WHAT="all"

if [[ "$#" -ge 1 ]]; then
  case "$1" in
    identify)
      exit "${EXIT_IDENTIFY}"
      ;;
    list)
      printf '%s\n' "${SENSORS[@]}"
      exit 0
      ;;
    --version|-v|version)
      # This package's version, not ws-emit's, which belongs to
      # wildlifesystems-tools. The sr installed beside this script works it
      # out, which keeps one definition of where it comes from. An sr found
      # on PATH could belong to another installation, or to another package.
      SR="$(dirname -- "${BASH_SOURCE[0]}")/sr"
      VERSION=$("${BASH:-bash}" "${SR}" --version 2>/dev/null | awk '{print $3}')
      printf 'sensor-onboard (sensor-control) %s\n' "${VERSION:-unknown}"
      exit 0
      ;;
    setup|enable)
      # Nothing to configure: the onboard sensors are always present.
      printf 'Onboard sensors require no additional setup.\n'
      exit 0
      ;;
    mock)
      # Fixed readings in the real output format, for testing without the
      # hardware, and so that "sr --mock" and "sr check --mock" include this
      # driver. Values are plausible; the format is ws-emit's, so mock cannot
      # drift from a real read. Works without pi-data, that being the
      # situation mock exists for, by falling back to a fixed prefix.
      PI_SERIAL=$(pi-data serial 2>/dev/null) || PI_SERIAL=""
      emit --prefix "${PI_SERIAL:-onboard_mock}" --name "Mock onboard" \
        -- --sensor onboard_gpu  --measures temperature --unit celsius    --value 48.3 --precision 1 --location '{{node}}' \
        -- --sensor onboard_cpu  --measures temperature --unit celsius    --value 47.823 --precision 3 --location '{{node}}' \
        -- --sensor storage_used --measures storage     --unit percentage --value 31 --precision 0 --location '{{none}}' --device '' \
        -- --sensor memory_used  --measures memory      --unit percentage --value 42 --precision 0 --location '{{none}}' --device ''
      ;;
    external)
      # Every onboard sensor is internal, so external is always empty.
      printf '[]\n'
      exit 0
      ;;
    internal|all)
      WHAT="all"
      ;;
    *)
      if is_sensor "$1"; then
        WHAT="$1"
      else
        printf 'Unknown command: %s\n' "$1" >&2
        usage
        exit "${EXIT_INVALID_ARG}"
      fi
      ;;
  esac
fi

# Via pi-data, the same source sr uses for node_id. Parsing /proc/cpuinfo here
# instead would give ":" or an empty string on any layout that does not use the
# exact tab spacing a Raspberry Pi happens to emit, and every onboard sensor_id
# would then be malformed while node_id stayed correct.
#
# Checked the way sr checks it. If there is no serial there is no prefix, and
# ws-emit then emits sensor_id null: an unknown id recorded as unknown, rather
# than "_onboard_cpu" with an empty prefix, which looked like a real one.
if ! PI_SERIAL=$(pi-data serial 2>/dev/null) || [[ -z "${PI_SERIAL}" ]]; then
  printf 'Warning: Could not determine the node serial; sensor_id will be null\n' >&2
  PI_SERIAL=""
fi

# Each reading becomes one "--" group of arguments to ws-emit. Every figure is
# checked before it is used. One that cannot be read is reported as a failed
# reading, with value null and the reason in error, as the C drivers report
# one: omitting the reading would leave a consumer unable to tell "this node
# has no such sensor" from "this node has stopped reporting it", and a figure
# ws-emit rejects would lose every reading in the call.
ARGS=()

if [[ "${WHAT}" == "onboard_gpu" || "${WHAT}" == "all" ]]; then
  # vcgencmd prints temp=48.3'C. The sign is kept, since the firmware reports
  # temperatures below 0 C, and exactly one number must be found.
  GPU_TEMP=""
  if GPU_OUT=$(vcgencmd measure_temp 2>/dev/null); then
    GPU_TEMP=$(grep -Eo -- '-?[0-9]+(\.[0-9]+)?' <<<"${GPU_OUT}")
  fi
  if [[ "${GPU_TEMP}" =~ ^-?[0-9]+(\.[0-9]+)?$ ]]; then
    ARGS+=(-- --sensor onboard_gpu --measures temperature --unit celsius
           --value "${GPU_TEMP}" --precision 1 --location '{{node}}')
  else
    ARGS+=(-- --sensor onboard_gpu --measures temperature --unit celsius
           --error 'Could not read GPU temperature from vcgencmd'
           --location '{{node}}')
  fi
fi

if [[ "${WHAT}" == "onboard_cpu" || "${WHAT}" == "all" ]]; then
  # The kernel reports millidegrees, so report all three decimal places rather
  # than throwing them away by integer division. awk rather than shell
  # arithmetic, which truncates towards zero and would render a sub-zero reading
  # as "-5.-123"; awk is already required here for the memory figure.
  CPU_MILLIDEG=$(cat "${CPU_TEMP_FILE}" 2>/dev/null) || CPU_MILLIDEG=""
  if [[ "${CPU_MILLIDEG}" =~ ^-?[0-9]+$ ]]; then
    CPU_TEMP=$(awk -v m="${CPU_MILLIDEG}" 'BEGIN { printf "%.3f", m / 1000 }')
    ARGS+=(-- --sensor onboard_cpu --measures temperature --unit celsius
           --value "${CPU_TEMP}" --precision 3 --location '{{node}}')
  else
    ARGS+=(-- --sensor onboard_cpu --measures temperature --unit celsius
           --error "Could not read CPU temperature from ${CPU_TEMP_FILE}"
           --location '{{node}}')
  fi
fi

# The two pseudo-sensors measure nothing physical, so they carry no device:
# an empty --device overrides the raspberry_pi the real sensors report.
if [[ "${WHAT}" == "storage_used" || "${WHAT}" == "all" ]]; then
  # The root filesystem's use, as df rounds it, whether the filesystem is
  # local or not.
  PC_USED=$(df --output=pcent / 2>/dev/null | tail -n 1 | tr -dc '0-9')
  if [[ "${PC_USED}" =~ ^[0-9]+$ ]]; then
    ARGS+=(-- --sensor storage_used --measures storage --unit percentage
           --value "${PC_USED}" --precision 0 --location '{{none}}' --device '')
  else
    ARGS+=(-- --sensor storage_used --measures storage --unit percentage
           --error 'Could not read storage use from df'
           --location '{{none}}' --device '')
  fi
fi

if [[ "${WHAT}" == "memory_used" || "${WHAT}" == "all" ]]; then
  # In the C locale, where free labels its row "Mem:" whatever the node's
  # language. Both figures must be whole numbers, and the total above zero.
  MEM_USED=""
  MEM_TOTAL=""
  read -r MEM_USED MEM_TOTAL < <(LC_ALL=C free 2>/dev/null | awk '/^Mem:/ {print $3, $2}')
  if [[ "${MEM_USED}" =~ ^[0-9]+$ && "${MEM_TOTAL}" =~ ^[0-9]+$ ]] && (( MEM_TOTAL > 0 )); then
    PC_USED=$(( 100 * MEM_USED / MEM_TOTAL ))
    ARGS+=(-- --sensor memory_used --measures memory --unit percentage
           --value "${PC_USED}" --precision 0 --location '{{none}}' --device '')
  else
    ARGS+=(-- --sensor memory_used --measures memory --unit percentage
           --error 'Could not read memory use from free'
           --location '{{none}}' --device '')
  fi
fi

emit --prefix "${PI_SERIAL}" "${ARGS[@]}"
