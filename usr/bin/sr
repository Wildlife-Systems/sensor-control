#!/usr/bin/env bash

# WildlifeSystems - sensor read
#
# Standard wrapper for reading sensors in WildlifeSystems. Handles running
# sensor scripts (serially or in parallel), inserting device serial number
# and timestamp into JSON responses, and aggregating results.
#
# For more information: https://docs.wildlife.systems

set -u
set -o pipefail

# The package version, from the installed changelog. sensor-onboard reports
# the same package's version by asking "sr --version", so this is the one
# place it is worked out.
sensor_control_version() {
  local changelog=/usr/share/doc/sensor-control/changelog.gz
  local version=""
  if [[ -f "${changelog}" ]]; then
    version=$(zcat "${changelog}" 2>/dev/null | head -n1 | sed -n 's/^sensor-control (\([^)]*\)).*/\1/p')
  fi
  printf '%s\n' "${version:-unknown}"
}

# Handle --version early, before checking dependencies
if [[ $# -gt 0 ]] && [[ "$1" == "--version" || "$1" == "-v" ]]; then
  printf 'sr (sensor-control) %s\n' "$(sensor_control_version)"
  exit 0
fi

readonly REQUIRED_CMDS=(jq timeout find basename sed awk pi-data mktemp)

missing=()
for _cmd in "${REQUIRED_CMDS[@]}"; do
  if ! command -v "$_cmd" >/dev/null 2>&1; then
    missing+=("$_cmd")
  fi
done
if (( ${#missing[@]} )); then
  printf 'Missing required commands: %s\n' "${missing[*]}" >&2
  exit 1
fi

if [[ $# -eq 0 ]]; then
  printf 'Usage: sr <command> [--sensor <type>] [--sensor_id <id>] [--with-errors] [--mock]\n' >&2
  printf 'Commands: list, check, all, internal, external, <sensor-name>\n' >&2
  exit 2
fi

# Parse arguments
SCRIPT=""
SENSOR_ARG=""
FILTER_SENSOR=""
FILTER_SENSOR_ID=""
FILTER_WITH_ERRORS=false
MOCK_MODE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --version|-v)
      printf 'sr (sensor-control) %s\n' "$(sensor_control_version)"
      exit 0
      ;;
    --sensor)
      if [[ -z "${2:-}" ]]; then
        printf 'Error: --sensor requires a value\n' >&2
        exit 2
      fi
      FILTER_SENSOR="$2"
      shift 2
      ;;
    --sensor_id)
      if [[ -z "${2:-}" ]]; then
        printf 'Error: --sensor_id requires a value\n' >&2
        exit 2
      fi
      FILTER_SENSOR_ID="$2"
      shift 2
      ;;
    --with-errors)
      FILTER_WITH_ERRORS=true
      shift
      ;;
    --mock)
      MOCK_MODE=true
      shift
      ;;
    -*)
      printf 'Error: Unknown option "%s"\n' "$1" >&2
      exit 2
      ;;
    *)
      if [[ -z "${SCRIPT}" ]]; then
        SCRIPT="$1"
      elif [[ -z "${SENSOR_ARG}" ]]; then
        # The second positional is handed to the device's driver as its
        # argument, so "sr onboard onboard_cpu" reads one sensor and
        # "sr dht11 list" lists a driver's measurements. It used to be
        # discarded, and the command ran "all" whatever was asked for.
        SENSOR_ARG="$1"
      else
        printf 'Error: Unexpected argument "%s"\n' "$1" >&2
        exit 2
      fi
      shift
      ;;
  esac
done

if [[ -z "${SCRIPT}" ]]; then
  # Default to 'all' if filters are specified but no command given
  if [[ -n "${FILTER_SENSOR}" ]] || [[ -n "${FILTER_SENSOR_ID}" ]] || [[ "${FILTER_WITH_ERRORS}" == "true" ]]; then
    SCRIPT="all"
  else
    printf 'Usage: sr <command> [--sensor <type>] [--sensor_id <id>] [--with-errors] [--mock]\n' >&2
    printf 'Commands: list, check, all, internal, external, <sensor-name>\n' >&2
    exit 2
  fi
fi

# The commands that span every device take no further argument.
case "${SCRIPT}" in
  list|check|all|internal|external)
    if [[ -n "${SENSOR_ARG}" ]]; then
      printf 'Error: "sr %s" takes no further argument\n' "${SCRIPT}" >&2
      exit 2
    fi
    ;;
esac

SELF="${BASH_SOURCE[0]:-$0}"
if [[ "${SELF}" != /* ]]; then
  if command -v "$(basename "${SELF}")" >/dev/null 2>&1; then
    SELF=$(command -v "$(basename "${SELF}")")
  else
    SELF="$(pwd)/${SELF}"
  fi
fi

readonly LOG_DIR=/var/log/sensor-control
# Where the drivers live. Overridable so the integration test can run sr
# against freshly built drivers rather than whatever is installed.
readonly SENS_DIR="${SENS_DIR:-/usr/bin}"
readonly TIMEOUT_SECS=10s
readonly KILL_AFTER=5s

mkdir -p "${LOG_DIR}" 2>/dev/null || true

# Get Pi serial number with validation
if ! PI_SERIAL=$(pi-data serial 2>/dev/null); then
  printf 'Error: Failed to retrieve Pi serial number\n' >&2
  exit 1
fi

if [[ -z "${PI_SERIAL}" ]]; then
  printf 'Error: Pi serial number is empty\n' >&2
  exit 1
fi

TSTAMP=$(date +%s)

# Node-level metadata, shipped by ws-node. Optional: a node without the file
# behaves exactly as before, with deployment_id left null.
readonly NODE_JSON_FILE="${NODE_JSON_FILE:-/etc/ws/node.json}"

# A malformed node.json must not stop sensors being read, so jq's failure is
# swallowed rather than allowed to end the script under "set -o pipefail".
DEPLOYMENT_ID=""
if [[ -r "${NODE_JSON_FILE}" ]]; then
  DEPLOYMENT_ID=$(jq -r '.deployment_id // empty' "${NODE_JSON_FILE}" 2>/dev/null) || DEPLOYMENT_ID=""
fi

# Add the node-level fields to a driver's readings: node_id, deployment_id
# where node.json carries one, and a timestamp for any reading without one.
# Reads the array on stdin. The one definition, so a field added here reaches
# "sr all" and "sr <device>" together.
inject_node_fields() {
  jq -c --arg node "${PI_SERIAL}" --arg dep "${DEPLOYMENT_ID}" --argjson ts "${TSTAMP}" \
    'map(.node_id = $node
         | .timestamp = (.timestamp // $ts)
         | if $dep == "" then . else .deployment_id = $dep end)'
}

run_list() {
  find "${SENS_DIR}" -maxdepth 1 -name 'sensor-*' -executable -print0 |
    while IFS= read -r -d '' SENS_SCRIPT; do
      timeout --kill-after="${KILL_AFTER}" "${TIMEOUT_SECS}" "${SENS_SCRIPT}" identify 2>/dev/null
      rc=$?
      if [[ $rc -eq 60 ]]; then
        SCRIPT_NAME=$(basename "${SENS_SCRIPT}")
        printf '%s\n' "${SCRIPT_NAME#sensor-}"
      fi
    done
}

if [[ "${SCRIPT}" == "list" ]]; then
  run_list
  exit 0
fi

# File listing the sensor_id of every sensor expected to be present on this
# node, one per line. Blank lines and #-comments are ignored, and {{serial}} is
# replaced with this node's serial number.
readonly EXPECTED_SENSORS_FILE="${EXPECTED_SENSORS_FILE:-/etc/ws/expected.sensors}"

# Verify that every expected sensor_id appears in the output of "sr all"
run_check() {
  if [[ ! -r "${EXPECTED_SENSORS_FILE}" ]]; then
    printf 'Error: Expected sensors file "%s" not found or not readable\n' "${EXPECTED_SENSORS_FILE}" >&2
    return 22
  fi

  local -a EXPECTED=()
  local LINE
  while IFS= read -r LINE || [[ -n "${LINE}" ]]; do
    # Strip comments, then leading and trailing whitespace (including CR)
    LINE="${LINE%%#*}"
    LINE="${LINE#"${LINE%%[![:space:]]*}"}"
    LINE="${LINE%"${LINE##*[![:space:]]}"}"
    # Expand {{serial}} so one expected sensors list can serve every node
    LINE="${LINE//'{{serial}}'/${PI_SERIAL}}"
    if [[ -n "${LINE}" ]]; then
      EXPECTED+=("${LINE}")
    fi
  done < "${EXPECTED_SENSORS_FILE}"

  if (( ${#EXPECTED[@]} == 0 )); then
    printf 'Error: Expected sensors file "%s" lists no sensors\n' "${EXPECTED_SENSORS_FILE}" >&2
    return 22
  fi

  local ALL_JSON
  local rc=0
  if [[ "${MOCK_MODE}" == "true" ]]; then
    ALL_JSON=$("${SELF}" all --mock) || rc=$?
  else
    ALL_JSON=$("${SELF}" all) || rc=$?
  fi

  if [[ ${rc} -ne 0 ]]; then
    printf 'Error: "sr all" failed with exit code %d\n' "${rc}" >&2
    return 1
  fi

  local PRESENT
  if ! PRESENT=$(jq -r '.[] | .sensor_id // empty' <<<"${ALL_JSON}" 2>/dev/null); then
    printf 'Error: Could not parse output of "sr all"\n' >&2
    return 1
  fi

  # Newline-delimited haystack so ids are matched in full, not as substrings
  local HAYSTACK=$'\n'"${PRESENT}"$'\n'
  local -a MISSING=()
  local SENSOR_ID
  for SENSOR_ID in "${EXPECTED[@]}"; do
    if [[ "${HAYSTACK}" != *$'\n'"${SENSOR_ID}"$'\n'* ]]; then
      MISSING+=("${SENSOR_ID}")
    fi
  done

  if (( ${#MISSING[@]} )); then
    printf 'Missing %d of %d expected sensors:\n' "${#MISSING[@]}" "${#EXPECTED[@]}" >&2
    printf '  %s\n' "${MISSING[@]}" >&2
    return 23
  fi

  printf 'OK: all %d expected sensors present\n' "${#EXPECTED[@]}"
  return 0
}

if [[ "${SCRIPT}" == "check" ]]; then
  run_check
  exit $?
fi

# Apply optional filters to JSON output
apply_filters() {
  local json="$1"
  
  if [[ -n "${FILTER_SENSOR}" ]]; then
    json=$(jq -c --arg sensor "${FILTER_SENSOR}" '[.[] | select(.sensor == $sensor)]' <<<"${json}")
  fi
  
  if [[ -n "${FILTER_SENSOR_ID}" ]]; then
    json=$(jq -c --arg sensor_id "${FILTER_SENSOR_ID}" '[.[] | select(.sensor_id == $sensor_id)]' <<<"${json}")
  fi
  
  if [[ "${FILTER_WITH_ERRORS}" == "true" ]]; then
    json=$(jq -c '[.[] | select(.error != null and .error != "")]' <<<"${json}")
  fi
  
  printf '%s\n' "${json}"
}

# Commands that run all sensors
readonly MULTI_SENSOR_CMDS="all external internal"

# Validate sensor name to prevent path traversal attacks
is_multi_cmd=false
for cmd in ${MULTI_SENSOR_CMDS}; do
  if [[ "${SCRIPT}" == "${cmd}" ]]; then
    is_multi_cmd=true
    break
  fi
done

if [[ "${is_multi_cmd}" == "false" ]]; then
  if [[ ! "${SCRIPT}" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    printf 'Error: Invalid sensor name "%s"\n' "${SCRIPT}" >&2
    exit 2
  fi
  if [[ -n "${SENSOR_ARG}" ]] && [[ ! "${SENSOR_ARG}" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    printf 'Error: Invalid sensor argument "%s"\n' "${SENSOR_ARG}" >&2
    exit 2
  fi
fi

# Default concurrency: from environment or CPU count, fall back to 4
CONCURRENCY=${CONCURRENCY:-$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)}
if ! [[ "${CONCURRENCY}" =~ ^[0-9]+$ ]] || [[ ${CONCURRENCY} -lt 1 ]]; then
  CONCURRENCY=4
fi

if [[ "${SCRIPT}" == "all" ]] || [[ "${SCRIPT}" == "internal" ]] || [[ "${SCRIPT}" == "external" ]]; then
  # Determine the command to pass to sensor scripts
  if [[ "${MOCK_MODE}" == "true" ]]; then
    SENSOR_CMD="mock"
  elif [[ "${SCRIPT}" == "all" ]]; then
    SENSOR_CMD="all"
  else
    SENSOR_CMD="${SCRIPT}"
  fi

  # Run sensor scripts in parallel, capture outputs to temp files
  declare -a SENSOR_NAMES=()
  declare -a OUT_FILES=()
  declare -a PIDS=()

  # Cleanup temp files on exit or interruption
  trap 'rm -f "${OUT_FILES[@]}" 2>/dev/null' EXIT INT TERM

  # Launch jobs
  while IFS= read -r SENSOR_NAME; do
    SENSOR_NAMES+=("${SENSOR_NAME}")
    SENS_SCRIPT="${SENS_DIR}/sensor-${SENSOR_NAME}"
    LOGFILE="${LOG_DIR}/${SENSOR_NAME}.log"

    OUT=$(mktemp)
    OUT_FILES+=("${OUT}")

    # Run sensor script in background, capture stdout to OUT, append stderr to LOGFILE
    timeout --preserve-status --signal=TERM --kill-after=${KILL_AFTER} ${TIMEOUT_SECS} "${SENS_SCRIPT}" "${SENSOR_CMD}" >"${OUT}" 2>>"${LOGFILE}" &
    PIDS+=("$!")

    # Throttle concurrency: if we have reached the limit, wait for the oldest job
    while (( ${#PIDS[@]} >= CONCURRENCY )); do
      pid_to_wait=${PIDS[0]}
      wait "${pid_to_wait}" || true
      # Remove first element
      PIDS=("${PIDS[@]:1}")
    done
  done < <(run_list)

  # Wait for remaining jobs
  for pid in "${PIDS[@]}"; do
    wait "${pid}" || true
  done

  # Process outputs in the same order as SENSOR_NAMES
  declare -a ALL_JSONS=()
  for i in "${!SENSOR_NAMES[@]}"; do
    OUT=${OUT_FILES[i]}

    # Read output safely
    SENS_JSON=""
    if [[ -s "${OUT}" ]]; then
      SENS_JSON=$(<"${OUT}")
    fi

    # Cleanup temp file
    rm -f "${OUT}"

    if [[ -z "${SENS_JSON}" ]]; then
      continue
    fi

    # Validate JSON before processing
    if ! jq -e . >/dev/null 2>&1 <<<"${SENS_JSON}"; then
      printf 'Warning: Invalid JSON from sensor "%s", skipping\n' "${SENSOR_NAMES[i]}" >&2
      continue
    fi

    SENS_JSON=$(inject_node_fields <<<"${SENS_JSON}")
    ALL_JSONS+=("${SENS_JSON}")
  done

  if (( ${#ALL_JSONS[@]} == 0 )); then
    printf '[]\n'
    exit 0
  fi

  # Merge all arrays and apply filters
  RESULT=$(printf '%s\n' "${ALL_JSONS[@]}" | jq -s 'add' -c)
  apply_filters "${RESULT}"
  exit 0
fi

# Single sensor invocation (non-parallel)
SENS_SCRIPT="${SENS_DIR}/sensor-${SCRIPT}"

# Check if sensor script exists
if [[ ! -x "${SENS_SCRIPT}" ]]; then
  printf 'Error: Sensor "%s" not found or not executable\n' "${SCRIPT}" >&2
  exit 21
fi

# The driver's argument: mock, else what was asked for, else everything.
# --mock takes precedence, since a driver's mock command takes no filter.
if [[ "${MOCK_MODE}" == "true" ]]; then
  SINGLE_SENSOR_CMD="mock"
elif [[ -n "${SENSOR_ARG}" ]]; then
  SINGLE_SENSOR_CMD="${SENSOR_ARG}"
else
  SINGLE_SENSOR_CMD="all"
fi

# "list" asks the driver what it measures. The answer is text, one name per
# line, not a reading array, so it is passed through untouched.
if [[ "${SINGLE_SENSOR_CMD}" == "list" ]]; then
  timeout --preserve-status --signal=TERM --kill-after=${KILL_AFTER} ${TIMEOUT_SECS} "${SENS_SCRIPT}" list
  exit $?
fi

# The same log file "sr all" uses for this driver, so one driver's stderr is
# in one place whichever way it was run.
SENS_LOG="${LOG_DIR}/${SCRIPT}.log"
rc=0
SENS_JSON=$(timeout --preserve-status --signal=TERM --kill-after=${KILL_AFTER} ${TIMEOUT_SECS} "${SENS_SCRIPT}" "${SINGLE_SENSOR_CMD}" 2>>"${SENS_LOG}") || rc=$?
rc=${rc:-0}

if [[ $rc -ne 0 ]]; then
  # To stderr, like every other diagnostic: stdout carries JSON or nothing,
  # so a caller piping into jq never sees prose. 20 is a driver rejecting the
  # argument it was given; anything else is the driver's own failure.
  if [[ $rc -eq 20 ]]; then
    printf 'Error: sensor-%s rejected "%s"\n' "${SCRIPT}" "${SINGLE_SENSOR_CMD}" >&2
  else
    printf 'Error: sensor-%s exited with status %d\n' "${SCRIPT}" "${rc}" >&2
  fi
  exit "$rc"
fi

# Validate JSON output
if [[ -z "${SENS_JSON}" ]]; then
  printf 'Error: Sensor produced no output\n' >&2
  exit 1
fi

if ! jq -e . >/dev/null 2>&1 <<<"${SENS_JSON}"; then
  printf 'Error: Sensor produced invalid JSON\n' >&2
  exit 1
fi

RESULT=$(inject_node_fields <<<"${SENS_JSON}")
apply_filters "${RESULT}"

exit 0
